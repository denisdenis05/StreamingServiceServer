# Logging:LogLevel
LOG_LEVEL=Information
ASPNETCORE_LOG_LEVEL=Warning

# ConnectionStrings
DATABASE_CONNECTION_STRING=''

# Jwt
JWT_SECRET_KEY=''
JWT_ISSUER=''
JWT_AUDIENCE=''

# LastFm
LASTFM_API_KEY=''
LASTFM_API_SECRET=''
LASTFM_REDIRECT=''

# Music:DownloadPath and Music:Path
# Use absolute HOST paths. Compose mounts them at /data/downloads and /data/music.
DOWNLOADS_HOST_PATH=''
MUSIC_HOST_PATH=''

# Music:External:MusicBrainz
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2/
MUSICBRAINZ_USER_AGENT=''

# Music:External:AlbumCover
ALBUM_COVER_BASE_URL=https://coverartarchive.org/

# Music:DownloadSource
DOWNLOAD_SOURCE_BASE_URL=''
DOWNLOAD_SOURCE_PARAMETERS=''
DOWNLOAD_SOURCE_RETRY_PARAMETERS=''

# Music:DownloadSource:Torrent
TORRENT_URL=''
TORRENT_USER=''
TORRENT_PASSWORD=''
TORRENT_MAX_DOWNLOADS=3

# Music:PreviewDownloader
PREVIEW_DOWNLOADER_ARGUMENTS='-x --audio-format mp3 --no-playlist -o'
PREVIEW_DOWNLOADER_SEARCH_ARGUMENTS='ytsearch1:'

# Cover
# Absolute HOST path, mounted at /data/covers.
COVERS_HOST_PATH=''
# Keep /images/ to match the application's existing image route.
COVER_DOMAIN_EXTENSION=/images/

# Domain
# Public origin including the scheme, without a trailing slash.
PUBLIC_BASE_URL=''

# Docker-specific settings
SERVER_BIND_ADDRESS=0.0.0.0
SERVER_USER=1654:1654
