map $uri $cover_cache_control {
    "~^/images/[a-f0-9]{64}-v[0-9]+-(full|small|thumbnail)\.jpg$" "public, max-age=31536000, immutable";
    default "public, max-age=60, must-revalidate";
}

server {
    listen 80;
    server_name _;
    merge_slashes off;
    client_max_body_size 20m;

    location ^~ /protected//data/music/ {
        internal;
        alias __MUSIC_DIRECTORY__;
        autoindex off;
        sendfile on;
        tcp_nopush on;
    }

    location ^~ /protected/ {
        internal;
        alias __MUSIC_DIRECTORY__;
        autoindex off;
        sendfile on;
        tcp_nopush on;
    }

    location ^~ /images/ {
        add_header Cache-Control $cover_cache_control;
        alias __IMAGES_DIRECTORY__;
        autoindex off;
        sendfile on;
        tcp_nopush on;
    }

    location / {
        proxy_pass http://__API_HOST__:3003;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}
